{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDatabase": "Server=Your_Server_Name;Database=AuthServiceDb;User Id=Your_User;Password=Your_Password;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "Your_Secret_Ket_Min_32_Chars",
    "Issuer": "Aventura",
    "Audience": "AventuraUsers",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cloudinary": {
    "CloudName": "Your_Cloud_Name",
    "ApiKey": "Your_API_Key",
    "ApiSecret": "Your_API_Secret"
  }
}
